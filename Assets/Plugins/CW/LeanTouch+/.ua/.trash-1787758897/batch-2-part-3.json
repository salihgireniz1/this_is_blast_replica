    {
      "id": "file:Required/Scripts/LeanSelectableDial.cs",
      "type": "file",
      "name": "LeanSelectableDial.cs",
      "filePath": "Required/Scripts/LeanSelectableDial.cs",
      "summary": "Turns the selected object into a dial or knob: dragging rotates it about a configured axis, with optional angle clamping and a list of angular triggers that fire enter/exit events.",
      "tags": [
        "selectable",
        "dial",
        "rotation",
        "ui",
        "monobehaviour"
      ],
      "complexity": "complex",
      "languageNotes": "GetPoint has two paths - RectTransformUtility for a Canvas dial (overlay and camera render modes handled separately) and a plane raycast for a world-space dial."
    },
    {
      "id": "class:Required/Scripts/LeanSelectableDial.cs:LeanSelectableDial",
      "type": "class",
      "name": "LeanSelectableDial",
      "filePath": "Required/Scripts/LeanSelectableDial.cs",
      "lineRange": [
        12,
        219
      ],
      "summary": "Accumulates the signed angle swept by the selecting finger around the dial axis, clamps it if configured, applies it as a local rotation on top of a tilt, and drives the angular Trigger enter/exit events.",
      "tags": [
        "selectable",
        "dial",
        "rotation",
        "trigger-zones"
      ],
      "complexity": "complex"
    },
    {

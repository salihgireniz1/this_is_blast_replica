{
  "nodes": [
    {
      "id": "file:Required/Scripts/LeanSelectableBlock.cs",
      "type": "file",
      "name": "LeanSelectableBlock.cs",
      "filePath": "Required/Scripts/LeanSelectableBlock.cs",
      "summary": "Reference implementation of a match-3 style grid block: it holds integer grid coordinates, swaps with the neighbouring block the selecting finger drags toward, and eases into its grid position.",
      "tags": [
        "example",
        "match-3",
        "grid",
        "selectable",
        "monobehaviour"
      ],
      "complexity": "moderate",
      "languageNotes": "Keeps a static Instances list registered in OnEnable/OnDisable, so FindBlock is an O(n) linear scan over all live blocks rather than a grid lookup."
    },
    {
      "id": "class:Required/Scripts/LeanSelectableBlock.cs:LeanSelectableBlock",
      "type": "class",
      "name": "LeanSelectableBlock",
      "filePath": "Required/Scripts/LeanSelectableBlock.cs",
      "lineRange": [
        11,
        131
      ],
      "summary": "A selectable grid block tracking x/y coordinates in a static instance registry; while selected it converts the finger position to a grid coordinate and swaps with an adjacent block, then damps its transform toward the target grid position.",
      "tags": [
        "example",
        "match-3",
        "grid",
        "selectable"
      ],
      "complexity": "moderate"
    },
    {
      "id": "class:Required/Scripts/LeanSelectableBlock.cs:LeanSelectableBlock_Editor",

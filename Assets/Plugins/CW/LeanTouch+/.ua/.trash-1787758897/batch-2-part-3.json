        "static",
        "grid",
        "swap"
      ],
      "complexity": "simple"
    },
    {
      "id": "function:Required/Scripts/LeanSelectableBlock.cs:Update",
      "type": "function",
      "name": "Update",
      "filePath": "Required/Scripts/LeanSelectableBlock.cs",
      "lineRange": [
        75,
        130
      ],
      "summary": "While selected, projects the selecting finger to a world point at the block's depth, rounds it to a grid coordinate, and if that coordinate is orthogonally adjacent swaps with the block found there (optionally deselecting); then damps localPosition toward x/y * BlockSize.",
      "tags": [
        "unity-lifecycle",
        "grid",
        "match-3",
        "damping"
      ],
      "complexity": "moderate"
    },
    {

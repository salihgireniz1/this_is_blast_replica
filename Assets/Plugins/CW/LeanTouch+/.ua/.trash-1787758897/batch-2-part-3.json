    },
    {
      "id": "function:Required/Scripts/LeanSelectableBlock.cs:Swap",
      "type": "function",
      "name": "Swap",
      "filePath": "Required/Scripts/LeanSelectableBlock.cs",
      "lineRange": [
        63,
        73
      ],
      "summary": "Static helper exchanging the x/y grid coordinates of two blocks; the damped Update then animates both into their new positions.",

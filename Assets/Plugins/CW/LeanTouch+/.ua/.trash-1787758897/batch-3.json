    {
      "id": "file:Required/Scripts/LeanShapeDetector.cs",
      "type": "file",
      "name": "LeanShapeDetector.cs",
      "filePath": "Required/Scripts/LeanShapeDetector.cs",
      "summary": "The package's gesture-recognition core: records each finger's stroke as a decimated point list and, on release, matches it against a reference LeanShape using point-to-segment distance with configurable distance/error thresholds, partial-match minimums and forward/backward direction ranges, firing OnDetected on a match.",
      "tags": ["gesture", "recognition", "algorithm", "geometry", "editor-only"],
      "complexity": "complex",
      "languageNotes": "Pools FingerData instances in a static Stack and reuses static scratch collections (ranges, fittedShape, referenceLines) to avoid per-frame GC allocations — a common Unity mobile optimisation."
    },
    {
      "id": "class:Required/Scripts/LeanShapeDetector.cs:LeanShapeDetector",
